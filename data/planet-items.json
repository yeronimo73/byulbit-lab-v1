  "items": [
    { "id": 1, "text": "스스로의 의지와 방향을 분명히 드러낼 때 에너지가 살아난다", "planet": "sun", "reverse": false },
    { "id": 2, "text": "주변 사람들에게 빛·격려·중심 역할을 자주 맡는 편이다", "planet": "sun", "reverse": false },
    { "id": 3, "text": "인정받지 못하면 동력이 급격히 꺼지는 느낌이 든다", "planet": "sun", "reverse": false },
    { "id": 4, "text": "감정의 파도를 몸으로 먼저 느끼는 편이다", "planet": "moon", "reverse": false },
    { "id": 5, "text": "소속·안식·익숙한 리듬이 마음의 바탕이 된다", "planet": "moon", "reverse": false },
    { "id": 6, "text": "분위기나 타인의 기분에 쉽게 맞춰진다", "planet": "moon", "reverse": false },
    { "id": 7, "text": "말하기 전에 생각을 정리하고 연결고리를 찾는다", "planet": "mercury", "reverse": false },
    { "id": 8, "text": "새 정보·새 대화에 호기심이 빠르게 반응한다", "planet": "mercury", "reverse": false },
    { "id": 9, "text": "여러 갈래 아이디어를 동시에 다루는 것이 편하다", "planet": "mercury", "reverse": false },
    { "id": 10, "text": "아름다움·조화·분위기를 중시한다", "planet": "venus", "reverse": false },
    { "id": 11, "text": "관계에서 따뜻함과 매력을 나누는 것이 중요하다", "planet": "venus", "reverse": false },
    { "id": 12, "text": "갈등보다 부드러운 조율을 먼저 찾으려 한다", "planet": "venus", "reverse": false },
    { "id": 13, "text": "목표가 보이면 망설임 없이 직진하는 편이다", "planet": "mars", "reverse": false },
    { "id": 14, "text": "열이 올라가면 행동·말이 빨라진다", "planet": "mars", "reverse": false },
    { "id": 15, "text": "경쟁이나 도전이 오히려 동력이 되기도 한다", "planet": "mars", "reverse": false },
    { "id": 16, "text": "의미·성장·확장 가능성을 넓게 본다", "planet": "jupiter", "reverse": false },
    { "id": 17, "text": "낙관적 시야로 상황의 여지를 먼저 본다", "planet": "jupiter", "reverse": false },
    { "id": 18, "text": "가르침·조언·길잡이 역할에 자연스럽다", "planet": "jupiter", "reverse": false },
    { "id": 19, "text": "구조·책임·시간을 두고 쌓는 것을 신뢰한다", "planet": "saturn", "reverse": false },
    { "id": 20, "text": "경계와 규칙이 있어야 마음이 안정된다", "planet": "saturn", "reverse": false },
    { "id": 21, "text": "느리더라도 견고한 결과를 선호한다", "planet": "saturn", "reverse": false },
    { "id": 22, "text": "틀을 벗어난 아이디어에 전율이 온다", "planet": "uranus", "reverse": false },
    { "id": 23, "text": "예측 불가한 순간에 영감이 가장 크게 온다", "planet": "uranus", "reverse": false },
    { "id": 24, "text": "남들과 다른 자기 속도를 지키려 한다", "planet": "uranus", "reverse": false }
  ]
}